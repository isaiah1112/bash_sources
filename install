#!/bin/bash
# Install the bash_sources loader and setup our environment
set -euo pipefail

# Script directory
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly HOME_DIR="${HOME:?HOME environment variable not set}"
readonly BACKUP_SUFFIX=".pre-bash_sources"
readonly FORCE_INSTALL="${FORCE_INSTALL:-0}"

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Helper functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $*"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

# Verify script is being run from the correct directory
verify_directory_structure() {
    if [[ ! -d "${SCRIPT_DIR}/bash_sources" ]]; then
        log_error "bash_sources directory not found at ${SCRIPT_DIR}/bash_sources"
        exit 1
    fi
    
    if [[ ! -d "${SCRIPT_DIR}/ssh" ]]; then
        log_error "ssh directory not found at ${SCRIPT_DIR}/ssh"
        exit 1
    fi
}

# Validate bash source file format
validate_bash_file() {
    local file="$1"
    if [[ -f "$file" ]]; then
        if ! bash -n "$file" 2>/dev/null; then
            log_error "Syntax error in $file"
            return 1
        fi
    fi
    return 0
}

# Safe backup of existing file
safe_backup() {
    local target="$1"
    if [[ -e "$target" && ! -L "$target" ]]; then
        if [[ -e "${target}${BACKUP_SUFFIX}" ]]; then
            log_warn "Backup ${target}${BACKUP_SUFFIX} already exists, skipping backup"
        else
            cp "$target" "${target}${BACKUP_SUFFIX}"
            log_info "Backed up ${target} to ${target}${BACKUP_SUFFIX}"
        fi
    fi
}

# Install symlink
install_symlink() {
    local source="$1"
    local target="$2"
    local description="$3"
    
    if [[ ! -e "$source" ]]; then
        log_error "Source file not found: $source"
        return 1
    fi
    
    # Check if already installed and not forcing
    if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source" ]]; then
        log_warn "$description already installed at $target"
        if [[ "${FORCE_INSTALL}" != "1" ]]; then
            return 0
        fi
        log_info "Force installing (removing existing symlink)"
        rm "$target"
    fi
    
    # Create parent directory if needed
    mkdir -p "$(dirname "$target")"
    
    # Backup existing file
    safe_backup "$target"
    
    # Create symlink with absolute path
    ln -snf "$source" "$target"
    log_info "$description installed successfully"
}

# Install bashrc components
install_bashrc() {
    log_info "Installing bash_sources bashrc components..."
    
    validate_bash_file "${SCRIPT_DIR}/bash_sources/bash_profile.sh" || return 1
    validate_bash_file "${SCRIPT_DIR}/bash_sources/bashrc.sh" || return 1
    
    install_symlink "${SCRIPT_DIR}/bash_sources/bash_profile.sh" "${HOME_DIR}/.bash_profile" "bash_profile.sh"
    install_symlink "${SCRIPT_DIR}/bash_sources/bashrc.sh" "${HOME_DIR}/.bashrc" "bashrc.sh"
    
    # Create bash_sources directory and install default sources
    mkdir -p "${HOME_DIR}/.bash_sources.d"
    
    # Install base profile
    src_file="${SCRIPT_DIR}/bash_sources/00_default.sh"
    src_name=$(basename "$src_file")
    validate_bash_file "$src_file" || {
        log_warn "Skipping invalid file: $src_name"
        continue
    }
    install_symlink "$src_file" "${HOME_DIR}/.bash_sources.d/${src_name}" "$src_name"
    
    log_info "bash_sources bashrc installation complete. Please reload your terminal."
}

# Install vimrc
install_vimrc() {
    log_info "Installing vimrc..."
    
    if [[ ! -f "${SCRIPT_DIR}/vimrc" ]]; then
        log_error "vimrc file not found"
        return 1
    fi
    
    install_symlink "${SCRIPT_DIR}/vimrc" "${HOME_DIR}/.vimrc" "vimrc"
    log_info "vimrc installation complete"
}

# Install ssh config
install_sshcfg() {
    log_info "Installing ssh config..."
    
    if [[ ! -f "${SCRIPT_DIR}/ssh/config" ]]; then
        log_error "ssh/config file not found"
        return 1
    fi
    
    # Ensure .ssh directory exists with proper permissions
    mkdir -p "${HOME_DIR}/.ssh"
    chmod 700 "${HOME_DIR}/.ssh"
    
    install_symlink "${SCRIPT_DIR}/ssh/config" "${HOME_DIR}/.ssh/config" "ssh/config"
    log_info "ssh config installation complete"
}

# Install individual bash source
install_source() {
    local source_name="$1"
    local src_file="${SCRIPT_DIR}/bash_sources/${source_name}"
    
    if [[ ! -f "${SCRIPT_DIR}/bash_sources/.bash_sources.d" ]]; then
        log_error ".bash_sources.d not found. Please run 'install bashrc' first"
        return 1
    fi
    
    if [[ ! -f "$src_file" ]]; then
        log_error "Source file not found: $source_name"
        log_info "Available sources:"
        ls -1 "${SCRIPT_DIR}/bash_sources"/*.sh 2>/dev/null | grep -v -E "(bash_profile|bashrc)" | xargs -n1 basename || true
        return 1
    fi
    
    if [[ "$source_name" == "bash_profile.sh" || "$source_name" == "bashrc.sh" ]]; then
        log_error "Please run 'install bashrc' to install the bashrc loaders"
        return 1
    fi
    
    validate_bash_file "$src_file" || return 1
    
    install_symlink "$src_file" "${HOME_DIR}/.bash_sources.d/${source_name}" "$source_name"
    log_info "Please run 'profile reload' or reload your terminal to load this source"
}

# Show usage
usage() {
    cat << EOF
Usage: $(basename "$0") [OPTION] [TARGET]

OPTIONS:
    bashrc              Install bash_sources bashrc loader and all sources
    vimrc               Install vimrc configuration
    sshcfg              Install ssh config
    <source_file>       Install individual bash source (e.g., 10_darwin.sh)
    -h, --help          Show this help message
    
ENVIRONMENT VARIABLES:
    FORCE_INSTALL=1     Force reinstall even if already installed

EXAMPLES:
    $(basename "$0") bashrc
    $(basename "$0") vimrc
    $(basename "$0") 60_docker.sh
    FORCE_INSTALL=1 $(basename "$0") bashrc

EOF
}

# Main
main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi
    
    # Handle help flag
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
        usage
        exit 0
    fi
    
    # Verify directory structure
    verify_directory_structure
    
    case "$1" in
        bashrc)
            install_bashrc
            ;;
        vimrc)
            install_vimrc
            ;;
        sshcfg)
            install_sshcfg
            ;;
        *)
            # Install as a source file
            install_source "$1"
            ;;
    esac
}

main "$@"